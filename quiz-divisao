<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>A Super Aventura da Divisão</title>
<style>
/* ===================== BASE ===================== */
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --roxo:#7c3aed; --roxo2:#a855f7;
  --rosa:#ec4899; --laranja:#f97316;
  --amarelo:#facc15; --verde:#22c55e;
  --azul:#3b82f6; --ciano:#06b6d4;
  --vermelho:#ef4444;
  --escuro:#1e1b4b; --papel:#fffdf7;
  --sombra:0 6px 0 rgba(0,0,0,.18);
}
html,body{margin:0;padding:0}
html{background:#f3f0ff}
body{
  font-family:'Comic Sans MS','Chalkboard SE','Comic Neue','Marker Felt',"Trebuchet MS",sans-serif;
  background:
    radial-gradient(circle at 12% 12%, #ffe9a8 0 16%, transparent 16.5%),
    radial-gradient(circle at 88% 8%, #bdf5d6 0 13%, transparent 13.5%),
    radial-gradient(circle at 80% 62%, #ffd3e8 0 15%, transparent 15.5%),
    radial-gradient(circle at 16% 76%, #cfe4ff 0 14%, transparent 14.5%),
    radial-gradient(circle at 92% 94%, #ffe3c7 0 14%, transparent 14.5%),
    linear-gradient(160deg,#fef9ff 0%,#eef6ff 50%,#fff6ee 100%);
  background-repeat:no-repeat;
  color:var(--escuro);
  min-height:100vh;
  overflow-x:hidden;
}
.wrap{max-width:820px;margin:0 auto;padding:12px 14px 90px}

/* ===================== HUD ===================== */
#hud{
  position:sticky;top:0;z-index:50;
  display:none;gap:8px;align-items:center;flex-wrap:wrap;
  background:linear-gradient(90deg,var(--roxo),var(--rosa));
  color:#fff;border-radius:0 0 22px 22px;
  padding:10px 14px;box-shadow:0 5px 18px rgba(124,58,237,.35);
  margin:0 -14px 14px;
}
#hud .pill{
  background:rgba(255,255,255,.22);border-radius:999px;
  padding:5px 12px;font-size:15px;font-weight:bold;white-space:nowrap;
  border:2px solid rgba(255,255,255,.35);
}
#hud .nome{font-size:16px;margin-right:auto;text-shadow:0 2px 0 rgba(0,0,0,.2)}
#barraXP{flex:1 0 100%;height:12px;background:rgba(255,255,255,.3);border-radius:999px;overflow:hidden}
#barraXPfill{height:100%;width:0;background:linear-gradient(90deg,var(--amarelo),#fff59d);transition:width .5s cubic-bezier(.2,1.3,.4,1)}
.btn-voltar{background:rgba(255,255,255,.25);border:2px solid rgba(255,255,255,.4);color:#fff;
  border-radius:999px;padding:5px 12px;font-family:inherit;font-weight:bold;cursor:pointer;font-size:14px}

/* ===================== CARTÕES ===================== */
.card{
  background:var(--papel);border-radius:26px;padding:20px;
  box-shadow:0 10px 0 rgba(0,0,0,.07), 0 14px 30px rgba(80,60,140,.12);
  border:4px solid #fff;margin-bottom:16px;
}
h1{font-size:30px;margin:6px 0 4px;line-height:1.15;text-align:center;color:var(--roxo)}
h1.grad{
   background:linear-gradient(90deg,var(--roxo),var(--rosa),var(--laranja));
   -webkit-background-clip:text;background-clip:text;
   color:transparent;-webkit-text-fill-color:transparent}
h2{font-size:22px;margin:0 0 10px}
p{line-height:1.5;font-size:17px}
.mini{font-size:14px;opacity:.75}

/* ===================== BOTÕES ===================== */
button{font-family:inherit}
.btn{
  display:inline-block;border:none;border-radius:18px;cursor:pointer;
  padding:14px 24px;font-size:19px;font-weight:bold;color:#fff;
  background:linear-gradient(180deg,var(--verde),#16a34a);
  box-shadow:0 6px 0 #15803d;transition:transform .08s, box-shadow .08s;
}
.btn:active{transform:translateY(4px);box-shadow:0 2px 0 #15803d}
.btn.roxo{background:linear-gradient(180deg,var(--roxo2),var(--roxo));box-shadow:0 6px 0 #5b21b6}
.btn.roxo:active{box-shadow:0 2px 0 #5b21b6}
.btn.laranja{background:linear-gradient(180deg,#fb923c,var(--laranja));box-shadow:0 6px 0 #c2410c}
.btn.laranja:active{box-shadow:0 2px 0 #c2410c}
.btn.azul{background:linear-gradient(180deg,#60a5fa,var(--azul));box-shadow:0 6px 0 #1d4ed8}
.btn.azul:active{box-shadow:0 2px 0 #1d4ed8}
.btn.cinza{background:linear-gradient(180deg,#cbd5e1,#94a3b8);box-shadow:0 6px 0 #64748b;color:#1e293b}
.btn:disabled{opacity:.45;cursor:not-allowed}
.centro{text-align:center}

/* ===================== TELA INICIAL ===================== */
#inicio .foguete{font-size:80px;display:block;text-align:center;animation:flutua 2.6s ease-in-out infinite}
@keyframes flutua{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-16px) rotate(4deg)}}
.nomeBox{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;align-items:center;margin:14px 0 6px}
#campoNome{
  font-family:inherit;font-size:22px;font-weight:bold;text-align:center;color:var(--roxo);
  border:4px solid var(--roxo2);border-radius:18px;padding:12px 16px;width:min(300px,100%);
  background:#fff;outline:none;box-shadow:0 5px 0 rgba(124,58,237,.25)}
#campoNome:focus{border-color:var(--rosa);box-shadow:0 5px 0 rgba(236,72,153,.28)}
#campoNome::placeholder{color:#c4b5fd;font-weight:normal;font-size:18px}
#avisoNome{color:var(--vermelho);font-weight:bold;min-height:20px}
.jogadores{margin-top:10px}
.chipJog{background:#fff;border:3px solid var(--verde);border-radius:999px;padding:7px 14px;margin:4px;
  font-family:inherit;font-size:16px;font-weight:bold;color:#15803d;cursor:pointer;box-shadow:0 3px 0 #86efac}
.chipJog:active{transform:translateY(2px);box-shadow:0 1px 0 #86efac}
.chipJog small{font-weight:normal;opacity:.7}
.btn-trocar{background:rgba(255,255,255,.25);border:2px solid rgba(255,255,255,.4);color:#fff;
  border-radius:999px;padding:4px 10px;font-family:inherit;font-weight:bold;cursor:pointer;font-size:13px;margin-left:6px}
.faixa{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:14px 0}
.faixa span{background:#fff;border:3px solid var(--amarelo);border-radius:14px;padding:6px 10px;font-size:14px;font-weight:bold}

/* ===================== MAPA DE FASES ===================== */
.mapa{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px}
.fase-card{
  position:relative;border-radius:22px;padding:14px 12px;color:#fff;cursor:pointer;
  text-align:center;border:4px solid #fff;box-shadow:var(--sombra);
  transition:transform .12s;
}
.fase-card:hover{transform:translateY(-4px) rotate(-1deg)}
.fase-card .emoji{font-size:40px;display:block}
.fase-card .tit{font-size:15px;font-weight:bold;margin-top:4px;line-height:1.2;text-shadow:0 2px 0 rgba(0,0,0,.25)}
.fase-card .num{position:absolute;top:-10px;left:-10px;background:#fff;color:var(--escuro);
  width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-weight:bold;
  box-shadow:0 3px 0 rgba(0,0,0,.15);font-size:15px}
.fase-card .stars{font-size:16px;margin-top:4px;letter-spacing:1px}
.fase-card.bloq{filter:grayscale(.85) brightness(.9);cursor:pointer}
.fase-card.feita::after{content:"✓";position:absolute;top:-8px;right:-8px;background:var(--verde);
  color:#fff;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;
  border:3px solid #fff;font-size:15px;font-weight:bold}

/* ===================== ATIVIDADES ===================== */
.pergunta{font-size:21px;font-weight:bold;margin:0 0 6px;line-height:1.35}
.contexto{background:#eef6ff;border-left:7px solid var(--azul);border-radius:0 14px 14px 0;
  padding:10px 14px;margin:0 0 12px;font-size:16px;line-height:1.5}
.opcoes{display:grid;gap:10px;margin-top:12px}
.opcao{
  background:#fff;border:4px solid #e5e7eb;border-radius:18px;padding:14px 16px;
  font-size:19px;font-weight:bold;cursor:pointer;text-align:left;transition:.12s;display:flex;gap:10px;align-items:center;
}
.opcao:hover{border-color:var(--roxo2);transform:translateX(4px)}
.opcao .letra{background:var(--roxo2);color:#fff;width:32px;height:32px;border-radius:10px;
  display:grid;place-items:center;flex:0 0 auto;font-size:17px}
.opcao.certa{border-color:var(--verde);background:#dcfce7;animation:pulso .4s}
.opcao.errada{border-color:var(--vermelho);background:#fee2e2;animation:tremer .35s}
.opcao.revela{border-color:var(--verde);background:#f0fdf4}
@keyframes pulso{0%{transform:scale(1)}50%{transform:scale(1.05)}100%{transform:scale(1)}}
@keyframes tremer{0%,100%{transform:translateX(0)}20%{transform:translateX(-8px)}40%{transform:translateX(8px)}60%{transform:translateX(-5px)}80%{transform:translateX(5px)}}

.campos{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:12px}
.campo{display:flex;align-items:center;gap:8px;background:#fff;border:4px solid #e5e7eb;
